ARG UV_VERSION=0.12.23
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM golang:1.27

ARG NODE_MAJOR=22
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

USER root

# Pacotes base
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  gnupg \
  jq \
  less \
  openssh-client \
  postgresql-client \
  ripgrep \
  unzip \
  vim \
  sudo \
  build-essential \
  python3 \
  python3-dev \
  python3-venv \
  python3-pip \
  make \
  g++ \
  openssl \
  procps \
  bubblewrap \
  lsof \
  && rm -rf /var/lib/apt/lists/*

# uv/uvx para instalar e executar ferramentas Python, incluindo o Specify CLI
# do Spec Kit. Python, Git e certificados já estão nos pacotes base acima.
COPY --from=uv /uv /uvx /usr/local/bin/

# Node.js (repositório oficial NodeSource) + habilita yarn/pnpm via corepack
RUN mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
  | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_${NODE_MAJOR}.x nodistro main" \
  > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends nodejs \
  && corepack enable \
  && rm -rf /var/lib/apt/lists/* \
  && node --version && npm --version

# GitHub CLI
RUN mkdir -p /etc/apt/keyrings \
  && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | gpg --dearmor -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && chmod a+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*

# Bun (runtime JS/TS — acelera context-mode e outras ferramentas)
RUN curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash

# CLIs globais via npm (instaladas como root, disponíveis para todos os usuários)
RUN npm install -g @anthropic-ai/claude-code \
  && npm install -g @openai/codex \
  && npm install -g opencode-ai \
  && npm install -g @juliusbrussee/caveman-code \
  && npm cache clean --force

# Usuário não-root com sudo sem senha (padrão de DevContainers)
RUN groupadd --gid ${USER_GID} ${USERNAME} \
  && useradd --uid ${USER_UID} --gid ${USER_GID} --create-home --shell /bin/bash ${USERNAME} \
  && usermod -aG sudo ${USERNAME} \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
  && chmod 0440 /etc/sudoers.d/${USERNAME}

# Diretório de trabalho com permissão para o usuário
RUN mkdir -p /workspaces/app && chown -R ${USERNAME}:${USERNAME} /workspaces/app

# A partir daqui tudo roda como não-root
USER ${USERNAME}
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

# Spec Kit exige Python 3.11+; ferramentas instaladas com `uv tool install`
# usam ~/.local/bin, já disponível no PATH do usuário final.
RUN python3 -c 'import sys; assert sys.version_info >= (3, 11), "Spec Kit exige Python 3.11+"' \
  && uv --version \
  && uvx --version

# rtk compresses command outputs before they reach the context window.
# Instalado como o usuário final, para ir para o $HOME dele e não para /root.
RUN curl -fsSL https://raw.githubusercontent.com/rtk-ai/rtk/master/install.sh | sh

WORKDIR /workspaces/app
