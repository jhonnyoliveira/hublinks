DATABASE_URL=postgresql://hublinks:hublinks@db:5432/hublinks?sslmode=disable
# Não rotacione PEPPER depois de haver eventos: isso altera a unicidade permanente.
PEPPER=exemplo-com-pelo-menos-32-caracteres
BASE_URL=http://localhost:8080
HTTP_ADDR=:8080
METRICS_ADDR=:9091
APP_ENV=production
TRUSTED_PROXIES=
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=troque-esta-senha-com-12-caracteres
ORG_NAME=Minha organização
REPORT_TZ=America/Sao_Paulo
EVENTS_RETENTION_DAYS=395
BOT_EVENTS_RETENTION_DAYS=30
TRASH_RETENTION_DAYS=30
BOT_DISTINCT_CODES=5
BOT_WINDOW=10s
PUBLIC_RATE_LIMIT=300
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW=15m
LOGIN_LOCKOUT=15m
EVENT_QUEUE_SIZE=10000
EVENT_BATCH_SIZE=500
EVENT_FLUSH_INTERVAL=1s
MAINTENANCE_AT=00:30
PRIVACY_CONTACT=privacidade@example.invalid
LOG_LEVEL=info
